# ===========================================
# 小红书助手 - 环境变量配置示例
# ===========================================
# 复制此文件为 .env 并填入实际值

# -------------------------------------------
# RedNote 内容生成服务配置
# -------------------------------------------
# RedNote 服务地址（必填）
REDNOTE_SERVICE_URL=http://localhost:8080

# RedNote 服务认证 Token（可选，如果服务需要认证）
# REDNOTE_AUTH_TOKEN=your-token-here

# 是否启用 RedNote 服务（默认 false，设为 true 启用）
REDNOTE_ENABLED=false

# RedNote 服务请求超时时间（秒，默认 60）
# REDNOTE_TIMEOUT=60

# -------------------------------------------
# Agent 后端配置
# -------------------------------------------
# Agent 后端类型: "native" | "nanobot" | "nanoclaw"
# 默认使用 nanobot
XHS_AGENT_BACKEND_TYPE=nanobot

# -------------------------------------------
# nanobot 配置（当 XHS_AGENT_BACKEND_TYPE=nanobot 时生效）
# -------------------------------------------

# === API 配置 ===
# API Key（必填）
# 支持多种格式，根据使用的服务选择
XHS_NANOBOT_API_KEY=your-api-key-here

# API Base URL（可选，用于自定义 LLM 服务）
# 留空则使用默认值

# --- 阿里云 DashScope（OpenAI 兼容接口，推荐）---
# XHS_NANOBOT_API_BASE=https://coding.dashscope.aliyuncs.com/v1
# XHS_NANOBOT_API_KEY=sk-xxx
# XHS_NANOBOT_MODEL=openai/qwen3-max-2026-01-23

# --- 阿里云 DashScope（Anthropic 兼容接口）---
# 注意：部分模型可能不支持此接口
# XHS_NANOBOT_API_BASE=https://coding.dashscope.aliyuncs.com/apps/anthropic
# XHS_NANOBOT_API_KEY=sk-xxx
# XHS_NANOBOT_MODEL=claude-sonnet-4-20250514

# --- Anthropic 官方 ---
# XHS_NANOBOT_API_BASE=  (留空使用默认)
# XHS_NANOBOT_MODEL=anthropic/claude-sonnet-4-20250514

# --- OpenAI 官方 ---
# XHS_NANOBOT_API_BASE=  (留空使用默认)
# XHS_NANOBOT_MODEL=openai/gpt-4o

# LLM 模型名称（使用 LiteLLM 格式）
# - Anthropic: claude-sonnet-4-20250514, claude-opus-4-20250514
# - OpenAI: gpt-4o, gpt-4o-mini
# - 阿里云: qwen-max, qwen-plus（使用 OpenAI 兼容接口时需加 openai/ 前缀）
XHS_NANOBOT_MODEL=claude-sonnet-4-20250514

# === 其他配置 ===
# 最大迭代次数（默认 40）
# XHS_NANOBOT_MAX_ITERATIONS=40

# nanobot 工作目录（默认 ./data/nanobot_workspace）
# XHS_NANOBOT_WORKSPACE=./data/nanobot_workspace

# 上下文窗口 token 数（默认 65536）
# XHS_NANOBOT_CONTEXT_WINDOW_TOKENS=65536

# 是否启用网络搜索（默认 false）
# XHS_NANOBOT_WEB_SEARCH_ENABLED=false

# 网络代理（可选）
# XHS_NANOBOT_WEB_PROXY=http://127.0.0.1:7890

# MCP 服务器配置（JSON 格式或简单格式）
# 简单格式: server1=/path/to/server,server2=/path/to/another
# JSON 格式: {"server1": {"command": "/path/to/server", "args": ["--port", "8080"]}}
# XHS_NANOBOT_MCP_SERVERS=

# -------------------------------------------
# 模块级后端覆盖（可选）
# 如果不设置，则使用全局 XHS_AGENT_BACKEND_TYPE
# -------------------------------------------
# 意图识别后端（可选覆盖）
# XHS_INTENT_BACKEND=nanobot

# 任务规划后端（可选覆盖）
# XHS_PLANNER_BACKEND=nanobot

# 步骤执行后端（可选覆盖）
# XHS_EXECUTOR_BACKEND=nanobot

# -------------------------------------------
# 兼容性配置（旧格式，仍然支持）
# -------------------------------------------
# Anthropic API Key（如果未设置 XHS_NANOBOT_API_KEY，则使用此值）
# ANTHROPIC_API_KEY=your-anthropic-api-key-here

# OpenAI API Key（如果未设置 XHS_NANOBOT_API_KEY，则使用此值）
# OPENAI_API_KEY=your-openai-api-key-here

# 自定义 API Base URL（如果未设置 XHS_NANOBOT_API_BASE，则使用此值）
# OPENAI_API_BASE=https://api.openai.com/v1

# -------------------------------------------
# Native 后端配置（当 XHS_AGENT_BACKEND_TYPE=native 时使用）
# -------------------------------------------
# 是否使用 LLM 进行意图识别（默认 false）
# XHS_ASSISTANT_USE_LLM_INTENT=true

# 意图识别使用的模型（默认 gpt-4o-mini）
# XHS_ASSISTANT_INTENT_MODEL=gpt-4o-mini

# -------------------------------------------
# 配置示例
# -------------------------------------------

# 示例 1: 使用阿里云 DashScope（Anthropic 兼容）
# XHS_AGENT_BACKEND_TYPE=nanobot
# XHS_NANOBOT_API_BASE=https://coding.dashscope.aliyuncs.com/apps/anthropic
# XHS_NANOBOT_API_KEY=sk-xxx
# XHS_NANOBOT_MODEL=claude-sonnet-4-20250514

# 示例 2: 使用阿里云 DashScope（OpenAI 兼容，调用 Qwen）
# XHS_AGENT_BACKEND_TYPE=nanobot
# XHS_NANOBOT_API_BASE=https://coding.dashscope.aliyuncs.com/v1
# XHS_NANOBOT_API_KEY=sk-xxx
# XHS_NANOBOT_MODEL=openai/qwen-max

# 示例 3: 使用 Anthropic 官方
# XHS_AGENT_BACKEND_TYPE=nanobot
# XHS_NANOBOT_API_KEY=sk-ant-xxx
# XHS_NANOBOT_MODEL=anthropic/claude-sonnet-4-20250514

# 示例 4: 使用 OpenAI 官方
# XHS_AGENT_BACKEND_TYPE=nanobot
# XHS_NANOBOT_API_KEY=sk-xxx
# XHS_NANOBOT_MODEL=openai/gpt-4o

# 示例 5: 纯本地运行（无 LLM）
# XHS_AGENT_BACKEND_TYPE=native
